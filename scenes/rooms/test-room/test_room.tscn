[gd_scene load_steps=5 format=3 uid="uid://bdi1jj5lmc7m5"]

[ext_resource type="PackedScene" uid="uid://ds5legxsulxns" path="res://scenes/player/player.tscn" id="1_bwhtm"]

[sub_resource type="GDScript" id="GDScript_6pla5"]
script/source = "extends Area2D

@export var dialogue_box: DialogueBox

var player_nearby := false

func _on_body_entered(body: Node2D) -> void:
	if body is CharacterBody2D:
		player_nearby = true

func _on_body_exited(body: Node2D) -> void:
	if body is CharacterBody2D:
		player_nearby = false

func _process(_delta: float) -> void:
	if player_nearby and not dialogue_box.visible:
		if Input.is_action_just_pressed(\"interact\"):
			dialogue_box.show_dialogue(\"Guide\", [
				\"Hello. I haven't seen you before.\",
				\"Please be careful.\"
			])
"

